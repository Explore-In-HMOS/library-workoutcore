export function runSwimStyleGoldenTest(): void {
  for (const c of CASES) {
    const clf: SwimStyleClassifier = new SwimStyleClassifier(30);
    for (const r of c.raw) {
      clf.onSample(r[0], r[1], r[2], r[3], r[4], r[5]);
    }
    const f: number[] = clf.features();
    let maxDiff: number = 0;
    for (let i = 0; i < f.length; i++) {
      maxDiff = Math.max(maxDiff, Math.abs(f[i] - c.features[i]));
    }
    const cls: number = SwimStyleClassifier.predict(f);
    const ok: boolean = maxDiff < 0.001 && cls === c.expected;
    console.info(`GOLDEN ${c.name}: ${ok ? 'PASS' : 'FAIL'}  class=${cls} expected=${c.expected}  maxDiff=${maxDiff.toFixed(6)}`);
  }
}
