export function runSwimCnnGoldenTest(): void {
  for (const c of CASES) {
    const t0: number = Date.now();
    const p: number[] = SwimStyleCnn.forward(c.raw);
    const ms: number = Date.now() - t0;
    let maxDiff: number = 0;
    for (let i = 0; i < 5; i++) {
      maxDiff = Math.max(maxDiff, Math.abs(p[i] - c.expected[i]));
    }
    const ok: boolean = maxDiff < 0.001;
    console.info(`CNN GOLDEN ${c.name}: ${ok ? 'PASS' : 'FAIL'}  maxDiff=${maxDiff.toFixed(6)}  time=${ms}ms`);
  }
}
